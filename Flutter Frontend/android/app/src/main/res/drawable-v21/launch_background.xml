<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash screen with dark navy background and centered logo (API 21+) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark navy background matching the splash screen color -->
    <item>
        <color android:color="#FF071724" />
    </item>
    <!-- Centered app icon -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
